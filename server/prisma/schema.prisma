generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- MANAGEMENT USER ---
model Users {
  userId    String   @id // Contoh: "admin", "staf_01"
  name      String
  email     String   @unique
  image     String?  @db.Text // Gunakan @db.Text untuk URL gambar yang panjang
  password  String
  createdAt DateTime @default(now())
}

// --- MANAGEMENT LAYOUT RAK ---
model Layouts {
  layoutId  String     @id // Contoh: "A-01-POL"
  type      String     // "POLOSAN" atau "PRINTING"
  baris     String
  kolom     String
  products  Products[]
  createdAt DateTime   @default(now())
}

// --- MANAGEMENT PRODUK / KAIN ---
model Products {
  productId     String   @id // Scan Barcode
  name          String
  color         String?
  design        String?
  category      String?  // POLOSAN atau PRINTING
  description   String?  @db.Text 
  imageVector   String?   @db.Text
  
  // Relasi Lokasi Rak
  location      String?  
  layout        Layouts? @relation(fields: [location], references: [layoutId], onDelete: SetNull)
  
  coordinateX   Int?      @default(0)
  coordinateY   Int?      @default(0)
  
  stockQuantity Float     @default(0)
  unit          String    @default("YARD")
  quality       String?   @default("L1")
  
  kombinasi     String?  
  imageUrl      String?   @db.Text // Gunakan @db.Text agar tidak terpotong jika URL panjang
  width         String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt 

  RiwayatMasuk  BarangMasuk[]
  RiwayatKeluar BarangKeluar[]

  @@index([location])
  @@index([category])
  @@index([kombinasi])
  @@index([name])
  @@index([description]) 
}

// --- TRACKING BARANG MASUK & KELUAR ---
model BarangMasuk {
  masukId    String   @id @default(uuid())
  productId  String
  tanggal    DateTime @default(now())
  jumlah     Float
  keterangan String?  
  product    Products @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@index([productId])
}

model BarangKeluar {
  keluarId   String   @id @default(uuid())
  productId  String
  tanggal    DateTime @default(now())
  jumlah     Float
  penerima   String?  
  product    Products @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@index([productId])
}

// --- FINANCIAL & OPERATIONAL SUMMARY ---
model OperasionalSummary {
  summaryId   String   @id @default(uuid())
  totalMasuk  Float
  totalKeluar Float
  tanggal     DateTime @default(now())
}

model Expenses {
  expenseId String   @id @default(uuid())
  category  String
  amount    Float
  timestamp DateTime @default(now())
}

model ExpenseSummary {
  expenseSummaryId  String               @id @default(uuid())
  totalExpenses     Float
  date              DateTime             @default(now())
  ExpenseByCategory ExpenseByCategory[]
}

model ExpenseByCategory {
  expenseByCategoryId String         @id @default(uuid())
  expenseSummaryId    String
  category            String
  amount              Float          
  date                DateTime       @default(now())
  expenseSummary      ExpenseSummary @relation(fields: [expenseSummaryId], references: [expenseSummaryId], onDelete: Cascade)
  
  @@index([expenseSummaryId]) // Tambahkan index untuk performa join
}